<?xml version="1.0" encoding="utf-8"?>
<!--
  HOW TO USE
  1. Copy this file to ConnectionStrings.config in this same folder (Project1).
  2. Replace YOUR_PASSWORD_HERE with the real database password.
     If the password contains & < or >, write them as &amp; &lt; &gt;
  3. Rebuild the app in Visual Studio.

  ConnectionStrings.config is listed in .gitignore, so the real password is never uploaded to GitHub.
  Only this example file (with no password) is in the repository.
-->
<connectionStrings>
  <add name="railway"
       connectionString="Server=railway-db.c5gwki0cwy64.ap-south-1.rds.amazonaws.com;Port=3306;Database=railway;Uid=dbs;Pwd=YOUR_PASSWORD_HERE;"
       providerName="MySql.Data.MySqlClient" />
</connectionStrings>
